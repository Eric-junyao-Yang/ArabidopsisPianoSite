#mean-center, then normalize all rows to between -1 and 1
LD_cols <- grep("^LD_", names(normalized_counts_df), value = TRUE)
mat <- as.matrix(normalized_counts_df[,LD_cols])
#mean center
mat <- mat - rowMeans(mat)
#min-max
mins <- rowMins(mat)
maxs <- rowMaxs(mat)
denom <- maxs - mins
keep_rows <- denom != 0
mat <- mat[keep_rows, ]
normalized_df <- normalized_counts_df[keep_rows, ]
mins <- mins[keep_rows]
maxs <- maxs[keep_rows]
mat <- (mat - mins) / denom * 2 - 1
normalized_df[, LD_cols] <- mat
View(normalized_df)
