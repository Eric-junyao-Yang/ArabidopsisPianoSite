dbg2 <- normalized_counts_df %>%
rowwise() %>%
mutate(
across(starts_with("LD_"),
~ {
vals <- c_across(starts_with("LD_")) - mean_count
denom <- max(vals) - min(vals)
if (denom == 0 || is.na(denom)) return(NA_real_)
((.x - mean_count) - min(vals)) / denom * 2 - 1
}
)
) %>%
ungroup()
View(dbg2)
