knitr::opts_chunk$set(echo = TRUE)
library(txdbmaker)
library(AnnotationDbi)
library(tximport)
library(DESeq2)
library(tidyverse)
library(ggplot2)
#Build tx2gene df
txdb <- makeTxDbFromGFF("/run/media/yeti1t3y/Extreme SSD/My_Codes/ArabidopsisPiano/RawReads/Arabidopsis_thaliana.TAIR10.62.gff3.gz")
seqlevels(txdb)
columns(txdb)
keytypes(txdb)
all_keys = keys(txdb, keytype = "TXNAME")
tx2gene <- AnnotationDbi::select(
txdb,
keys = all_keys,
columns = "GENEID",
keytype = "TXNAME")
tx2gene <- tx2gene %>% unique()
base_path = "/run/media/yeti1t3y/Extreme SSD/My_Codes/ArabidopsisPiano/RawReads/BulkRNAseq/fastp_out/salmon_out/"
file_extension = "/quant.sf"
quant_sf <- c(
LD_ZT02=paste0(base_path, "SRR10148637", file_extension),
LD_ZT05=paste0(base_path, "SRR10148638", file_extension),
LD_ZT08=paste0(base_path, "SRR10148639", file_extension),
LD_ZT11=paste0(base_path, "SRR10148640", file_extension),
LD_ZT14=paste0(base_path, "SRR10148641", file_extension),
LD_ZT17=paste0(base_path, "SRR10148642", file_extension),
LD_ZT20=paste0(base_path, "SRR10148643", file_extension),
LD_ZT23=paste0(base_path, "SRR10148644", file_extension),
LD_ZT26=paste0(base_path, "SRR10148645", file_extension),
LD_ZT29=paste0(base_path, "SRR10148646", file_extension),
LD_ZT32=paste0(base_path, "SRR10148647", file_extension),
LD_ZT35=paste0(base_path, "SRR10148648", file_extension),
LD_ZT38=paste0(base_path, "SRR10148649", file_extension),
LD_ZT41=paste0(base_path, "SRR10148650", file_extension),
LD_ZT44=paste0(base_path, "SRR10148651", file_extension),
LD_ZT47=paste0(base_path, "SRR10148652", file_extension)
)
txi <- tximport(
quant_sf,
type = "salmon",
tx2gene = tx2gene
)
txi$abundance
colData <- data.frame(
row.names = colnames(txi$counts),
timepoint = factor(colnames(txi$counts))
)
dds <- DESeqDataSetFromTximport(txi, colData, design = ~1)
dds <- estimateSizeFactors(dds)
normalized_counts <- counts(dds, normalized = TRUE)
#For sure drop all 0s
nrow(normalized_counts) #27588
normalized_counts_df <- data.frame(normalized_counts) %>% rownames_to_column("GeneID")
normalized_counts_df <- normalized_counts_df %>% filter(rowSums(normalized_counts_df %>% select(!GeneID)) != 0)
nrow(normalized_counts_df) #23518
normalized_counts_df <- normalized_counts_df %>%
mutate(mean_count = rowMeans(normalized_counts_df %>% select(!GeneID))) %>%
mutate(log_mean_count = log10(mean_count))
ggplot(data = normalized_counts_df, aes(y = log_mean_count)) +
geom_boxplot()
hist(normalized_counts_df$log_mean_count)
quantile(normalized_counts_df$mean_count, probs = c(0.05, 0.10, 0.25, 0.75, 0.90, 0.95))
#Normalize Volume to between 0 and 1 for the middle 90% of log10(mean_count), those above and below threshold will be placed at threshold.
#Actual volume can be set in js so lowest expressing genes get a non-zero volume
low_threshold <- quantile(normalized_counts_df$log_mean_count, 0.05)
high_treshold <- quantile(normalized_counts_df$log_mean_count, 0.95)
normalized_counts_df <- normalized_counts_df %>%
mutate(playback_vol = case_when(
log_mean_count <= low_threshold ~ low_threshold,
log_mean_count >= high_treshold ~ high_treshold,
TRUE ~ log_mean_count
)) %>%
mutate(playback_vol = (playback_vol - low_threshold) / (high_treshold - low_threshold))
View(normalized_counts_df)
#Save out normalized_counts with zero removed
write_csv(normalized_counts_df, "/run/media/yeti1t3y/Extreme SSD/My_Codes/ArabidopsisPiano/Processed_Data/normalized_non_zero.csv")
#mean-center, then normalize all rows to between -1 and 1
mean_center_df <- normalized_counts_df %>% select(starts_with("LD_"))
View(mean_center_df)
#mean-center, then normalize all rows to between -1 and 1
mean_center_df <- normalized_counts_df %>% mutate(across(starts_with("LD_"), ~ .x - mean_count))
View(mean_center_df)
mean_center_df %>% select(starts_width("LD_"))
mean_center_df %>% select(starts_with("LD_"))
mean_center_df %>% select(starts_with("LD_")) %>% rowMeans()
#mean-center, then normalize all rows to between -1 and 1
mean_center_df <- normalized_counts_df %>%
rowwise() %>%
mutate(
across(starts_with("LD_"),
~ {
x <- .x - mean_count ;
(x - min(x)) / (max(x) - min(x)) * 2 - 1
})) %>%
ungroup()
